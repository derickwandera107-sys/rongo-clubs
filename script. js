const CATEGORY_LABELS = {
  academic: "Academic & Debate",
  culture: "Culture & Arts",
  service: "Service & Values",
};

const grid = document.getElementById("clubGrid");
const searchInput = document.getElementById("searchInput");
const filterChips = document.querySelectorAll(".filter-chip");
const resultCount = document.getElementById("resultCount");
const emptyState = document.getElementById("emptyState");

let allClubs = [];
let activeFilter = "all";
let activeQuery = "";

async function loadClubs() {
  try {
    const res = await fetch("data/clubs.json");
    if (!res.ok) throw new Error("Failed to load club data");
    allClubs = await res.json();
    render();
  } catch (err) {
    grid.innerHTML = `<p class="empty-state">Couldn't load the club list right now. Check that data/clubs.json exists.</p>`;
    console.error(err);
  }
}

function contactLine(label, value, isLink, hrefPrefix) {
  if (!value || value.toLowerCase().startsWith("add ")) return "";
  const content = isLink
    ? `<a href="${hrefPrefix}${value}">${value}</a>`
    : value;
  return `<div class="meta-row"><span class="meta-label">${label}</span><span>${content}</span></div>`;
}

function cardTemplate(club) {
  const meta = [
    contactLine("Meets", [club.meetingTime, club.meetingPlace].filter(v => v && !v.toLowerCase().startsWith("add ")).join(" · ")),
    contactLine("Where", club.location),
    contactLine("Patron", club.patron),
    contactLine("Email", club.email, true, "mailto:"),
    contactLine("Phone", club.phone, true, "tel:"),
    contactLine("Instagram", club.instagram, true, "https://instagram.com/"),
  ].filter(Boolean).join("");

  return `
    <article class="club-card" data-category="${club.category}">
      <span class="card-tag">${CATEGORY_LABELS[club.category] || club.category}</span>
      <h2>${club.name}</h2>
      <p class="club-tagline">${club.tagline}</p>
      <p class="club-desc">${club.description}</p>
      ${meta ? `<div class="club-meta">${meta}</div>` : ""}
    </article>
  `;
}

function render() {
  const query = activeQuery.trim().toLowerCase();

  const filtered = allClubs.filter(club => {
    const matchesFilter = activeFilter === "all" || club.category === activeFilter;
    const haystack = `${club.name} ${club.tagline} ${club.description}`.toLowerCase();
    const matchesQuery = query === "" || haystack.includes(query);
    return matchesFilter && matchesQuery;
  });

  grid.innerHTML = filtered.map(cardTemplate).join("");
  emptyState.hidden = filtered.length !== 0;

  resultCount.textContent = filtered.length === allClubs.length
    ? `Showing all ${allClubs.length} clubs`
    : `Showing ${filtered.length} of ${allClubs.length} clubs`;
}

searchInput.addEventListener("input", (e) => {
  activeQuery = e.target.value;
  render();
});

filterChips.forEach(chip => {
  chip.addEventListener("click", () => {
    filterChips.forEach(c => c.classList.remove("is-active"));
    chip.classList.add("is-active");
    activeFilter = chip.dataset.filter;
    render();
  });
});

loadClubs();
